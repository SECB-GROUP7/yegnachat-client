<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="600" prefWidth="400"
            styleClass="settings-root"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.yegnachat.controllers.SettingsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="settings-topbar">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>

            <Label text="Settings" styleClass="settings-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="closeButton" styleClass="icon-button">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                        <Image url="@../../../icons/close.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="settings-scroll">
            <content>
                <VBox spacing="25">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20"/>
                    </padding>

                    <!-- PROFILE -->
                    <VBox alignment="CENTER" spacing="10">
                        <ImageView fx:id="avatarImage" fitHeight="120" fitWidth="120" preserveRatio="true"
                        onMouseClicked="#onChangeAvatar">
                            <clip>
                                <Circle centerX="60" centerY="60" radius="60"/>
                            </clip>
                        </ImageView>

                        <Label fx:id="usernameLabel"
                               text="Username"
                               styleClass="settings-username"/>

                        <Label fx:id="bioLabel"
                               text="This is your bio"
                               wrapText="true"
                               styleClass="settings-bio"/>

                        <Button fx:id="editBioButton"
                                text="Edit Bio"
                                styleClass="primary-button"/>
                    </VBox>

                    <Separator/>

                    <!-- PREFERRED LANGUAGE -->
                    <VBox spacing="10">
                        <Label text="Preferred Language" styleClass="section-title"/>
                        <TextField fx:id="languageField"
                                   promptText="en / am"/>

                        <Button fx:id="saveLanguageButton"
                                text="Save Language"
                                styleClass="secondary-button"/>
                    </VBox>

                    <Separator/>

                    <!-- ACCOUNT -->
                    <VBox spacing="12">
                        <Label text="Account" styleClass="section-title"/>

                        <Button fx:id="changePasswordButton"
                                text="Change Password"
                                styleClass="secondary-button"/>

                        <Button fx:id="logoutButton"
                                text="Logout"
                                styleClass="danger-button"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
