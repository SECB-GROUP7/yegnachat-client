<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.yegnachat.controllers.ChatController">

    <top>
        <HBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <ImageView fx:id="avatarView" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" />

                <Label fx:id="usernameLabel" text="Username">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="logoutButton" mnemonicParsing="false" text="Logout" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="messagesScroll" fitToWidth="true" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="messagesBox" spacing="8.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <TextField fx:id="messageField" promptText="Type a message..." HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" text="Send" />
            </children>
        </HBox>
    </bottom>

</BorderPane>