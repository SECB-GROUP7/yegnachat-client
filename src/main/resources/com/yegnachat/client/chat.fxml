<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="450.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yegnachat.controllers.ChatController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!-- HEADER -->
    <top>
        <Label text="Yegna Chat" BorderPane.alignment="CENTER">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>
    </top>

    <center>
        <ScrollPane fx:id="chat_scrollPane" fitToWidth="true" hbarPolicy="NEVER" BorderPane.alignment="CENTER">

            <content>
                <VBox fx:id="chat_messageBox" prefWidth="1.0" spacing="10.0"/>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0"/>
            </padding>

            <children>
                <TextField fx:id="chat_messageField" HBox.hgrow="ALWAYS"/>
                <Button fx:id="chat_sendButton" text="Send"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
