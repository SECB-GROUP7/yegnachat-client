<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yegnachat.controllers.ChatController">
<BorderPane prefHeight="700" prefWidth="1100" fx:id="mainPane">

    <left>
        <VBox prefWidth="280">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="10" left="15" right="10" top="10" />
                </padding>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Chats" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="settingsButton">
                    <graphic>
                        <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                            <Image url="@../../../icons/settings.png" />
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="newChatButton">
                    <graphic>
                        <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                            <Image url="@../../../icons/plus.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="feedButton">
                    <graphic>
                        <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                            <Image url="@../../../icons/feed.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" style=" -fx-background-insets: 0;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="chatListBox" spacing="8">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </left>

    <center>
        <BorderPane>

            <top>
                <HBox fx:id="titleHbox" alignment="CENTER_LEFT" spacing="12" style="-fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="12" left="15" right="15" top="12" />
                    </padding>
                    <ImageView fx:id="chatAvatar" fitHeight="48" fitWidth="48" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4,0,0,1);" />
                    <VBox spacing="2">
                        <Label fx:id="chatTitle" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Select a chat" />
                        <Label fx:id="chatSubtitle" style="-fx-text-fill: #888888; -fx-font-size: 12px;" text="" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
            </top>

            <center>
                <ScrollPane fx:id="messagesScroll" fitToWidth="true">
                    <content>
                        <VBox fx:id="messagesBox" spacing="10">
                            <padding>
                                <Insets bottom="15" left="15" right="15" top="15" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>

            <bottom>
                <HBox spacing="10" style=" -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                    <padding>
                        <Insets bottom="12" left="15" right="15" top="12" />
                    </padding>
                    <Button fx:id="translateButton" style="-fx-text-fill: white; -fx-background-radius: 6;" text="Translate" />
                    <TextField fx:id="messageField" promptText="Type a message..." styleClass="chat-input" HBox.hgrow="ALWAYS" />
                    <Button fx:id="sendButton" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 6;" text="Send" />
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
</StackPane>