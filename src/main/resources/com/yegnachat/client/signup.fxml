<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.yegnachat.controllers.SignupController">

    <children>
        <VBox alignment="CENTER" maxWidth="350" spacing="15">

            <padding>
                <Insets bottom="30" left="20" right="20" top="30"/>
            </padding>

            <Label text="Create  Account">
                <font>
                    <Font size="24"/>
                </font>
            </Label>

            <TextField fx:id="usernameField" prefWidth="250" promptText="Username"/>
            <PasswordField fx:id="passwordField" prefWidth="250" promptText="Password"/>

            <TextField fx:id="displayNameField" prefWidth="250" promptText="Display Name (Optional)"/>
            <TextField fx:id="avatarUrlField" prefWidth="250" promptText="Avatar URL (Optional)"/>


            <Button onAction="#handleSignup" prefWidth="250" text="Sign Up"/>

            <Hyperlink text="Already have an account? Login" onAction="#goToLogin"/>


            <Label fx:id="statusLabel" textFill="red"/>

        </VBox>
    </children>
</StackPane>
